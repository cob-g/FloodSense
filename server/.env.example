# Database
MONGODB_URI=mongodb://127.0.0.1:27017/floodsense

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
REPORT_RATE_LIMIT_MINUTES=3

# Email Configuration (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Password Reset
PASSWORD_RESET_EXPIRY_MINUTES=60
PASSWORD_RESET_URL=http://localhost:5173/auth/reset-password

# AI Chatbot (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_RATE_LIMIT_ANON_PER_MIN=10
CHAT_MAX_HISTORY=20
CHAT_MAX_INPUT_LENGTH=500

# Admin Configuration
ADMIN_EMAIL=admin@floodsense.local
ADMIN_PASSWORD=admin123

# Seeding
SEED_ADMIN=true
